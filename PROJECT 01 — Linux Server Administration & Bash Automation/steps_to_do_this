====================================================================
PART 16 - CREATE BACKUP SCRIPT
====================================================================

Go to scripts:

cd ~/devops-project/scripts


Create:

nano backup.sh


Paste:

#!/bin/bash

SOURCE="/var/log/nginx"

BACKUP_DIR="/home/ubuntu/devops-project/backups"

mkdir -p "$BACKUP_DIR"

DATE=$(date +"%Y-%m-%d-%H-%M-%S")

BACKUP_FILE="$BACKUP_DIR/nginx-$DATE.tar.gz"

tar -czf "$BACKUP_FILE" "$SOURCE"

echo "=================================="
echo "Nginx backup completed"
echo "=================================="

echo "Backup file:"
echo "$BACKUP_FILE"


Make executable:

chmod +x backup.sh


Run:

./backup.sh


Check:

ls -lh ~/devops-project/backups


